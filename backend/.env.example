# Copy this file to backend/.env and fill in real values. backend/.env is gitignored; never commit it.
# Blank values are ignored, so anything left empty falls back to its safe default (if it has one).

# ---------- Server ----------
PORT=8080

# ---------- Database ----------
# Supabase PostgreSQL: Dashboard > Connect > "Session pooler", then:
#   DB_URL      = jdbc:postgresql://<pooler-host>:5432/postgres?sslmode=require
#   DB_USERNAME = postgres.<project-ref>
#   DB_PASSWORD = your database password
# Leave all three empty to use the embedded H2 database in ./data instead.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=5

# ---------- Photo storage ----------
# Supabase Storage. Dashboard > Project Settings > API Keys:
#   SUPABASE_URL        = https://<project-ref>.supabase.co
#   SUPABASE_SECRET_KEY = a "Secret key" (sb_secret_...) or the legacy "service_role" key. Server-only.
# Leave both empty to keep photos in UPLOAD_DIR.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=jewelry
UPLOAD_DIR=./uploads

# ---------- Security ----------
# Signs login sessions. 32+ random characters; keep it the same between restarts.
# Generate one: openssl rand -base64 64
JWT_SECRET=
JWT_TTL_MINUTES=120
# true when the site is served over HTTPS
COOKIE_SECURE=false
# Comma-separated origins the site is opened from
FRONTEND_URL=http://localhost:5173/app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ---------- Owner account ----------
# Created on first start only (when no admin exists). Use a strong password and
# change it afterwards from Admin > Profile > Security.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Bryle Owner

# ---------- Starter data ----------
# Seed the starter catalogue into an empty database.
SEED_DEMO_DATA=true
# Optional demo customer account; leave empty to skip it.
DEMO_CUSTOMER_EMAIL=
DEMO_CUSTOMER_PASSWORD=
